# Modele de configuration locale. Copier ce fichier en `.env` puis lancer `npm run dev`.
# Ne jamais mettre de vrais secrets de production ici (ce fichier est versionne).

# Base SQLite locale (chemin relatif au dossier prisma/).
DATABASE_URL="file:./dev.db"

# Cle de signature des sessions et de chiffrement des secrets 2FA.
# Generer une valeur unique : openssl rand -base64 32
# Attention : la changer deconnecte tout le monde et oblige a reconfigurer la 2FA.
AUTH_SECRET="changez-moi"

NEXTAUTH_URL="http://localhost:3000"
