# Copier ce fichier vers .env.docker puis renseigner des vraies valeurs avant `docker compose up`.
# Ne jamais reutiliser les secrets de developpement (.env) en production.

# Mot de passe de la base PostgreSQL (choisir une valeur forte et unique).
POSTGRES_PASSWORD=change-me

# Cle de signature des sessions NextAuth. Generer avec : openssl rand -base64 32
AUTH_SECRET=change-me

# URL publique de l'application (utilisee pour les redirections d'authentification).
NEXTAUTH_URL=http://localhost:3000
